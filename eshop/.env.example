APP_NAME="Bílé zlato"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=cs
APP_FALLBACK_LOCALE=cs
APP_FAKER_LOCALE=cs_CZ

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite: database/database.sqlite (vytvoří se při nasazení, není v gitu)
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Na hostingu neběží worker – e-maily se posílají hned (sync)
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Lokálně se e-maily jen zapisují do storage/logs/laravel.log.
# Na serveru: MAIL_MAILER=resend a RESEND_API_KEY=re_…
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_FROM_ADDRESS="eshop@webtitan.cz"
MAIL_FROM_NAME="Bílé zlato (demo)"

# --- E-shop (config/shop.php) ---
# Kam chodí poptávky
INQUIRY_TO=jan@webtitan.cz
INQUIRY_PREFIX=VB
# Demo: objednávka = nezávazná poptávka bez platby
SHOP_DEMO=true
# Dokud je to demo, vyhledávače stránky neindexují
SHOP_INDEXABLE=false
SHOP_CONTACT_EMAIL=jan@webtitan.cz
SHOP_CONTACT_PHONE=

# První účet do administrace (/admin). Seeder ho založí jen pokud ještě neexistuje.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
